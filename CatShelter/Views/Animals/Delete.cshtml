@model CatShelter.Models.Animal.Animal

@{
    ViewData["Title"] = "Delete Animal";
}

<div class="w3-container"
     style="max-width:700px; margin:auto; padding:64px 16px;">

     <h2>Delete Animal</h2>

     <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>

    <div class="w3-panel w3-light-grey">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Sex:</strong> @Model.Sex</p>
        <p>
            <strong>Age:</strong>

            @if (Model.Age is not null)
            {
                <span>
                    @Model.Age.Years years
                    @Model.Age.Months months
                </span>
            }
            else
            {
                <span>Unknown</span>
            }
        </p>
        <p><strong>Status:</strong> @Model.Status</p>
    </div>

    <form asp-action="DeleteConfirmed" method="post">

        <input asp-for="Id" type="hidden" />

        <button type="submit"
                class="w3-button w3-red">
            Delete
        </button>
        <a asp-action="Index"
           class="w3-button w3-light-grey">
            Back
        </a>
    </form>

</div>
