@model CatShelter.ViewModels.Animals.EditAnimalViewModel

@{
    ViewData["Title"] = "Edit Animal";
}

<div class="w3-container"
     style="max-width:700px; margin:auto; padding:64px 16px;">

    <h2>Edit Animal</h2>

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="w3-text-red"></div>

        <div class="w3-margin-bottom">
            <label asp-for="Name"></label>
            <input asp-for="Name"
                   class="w3-input w3-border" />
            <span asp-validation-for="Name" class="w3-text-red"></span>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="Sex"></label>
            <select asp-for="Sex"
                    asp-items="Html.GetEnumSelectList<CatShelter.Models.Animal.Sex>()"
                    class="w3-select w3-border">
            </select>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="BirthDate"></label>
            <input asp-for="BirthDate"
                   type="date"
                   class="w3-input w3-border" />
            <span asp-validation-for="BirthDate" class="w3-text-red"></span>
        </div>
        <div class="w3-margin-bottom">
            <label>
                <input asp-for="IsBirthDateApproximate"
                       class="w3-check" />
                Approximate birth date
            </label>
        </div>
        <div class="w3-margin-bottom">
            <label>
                <input asp-for="IsSterilized"
                       class="w3-check" />
                Sterilized
            </label>
        </div>
        <div class="w3-margin-bottom">
            <label>
                <input asp-for="IsVaccinated"
                       class="w3-check" />
                Vaccinated
            </label>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="ShortDescription"></label>
            <textarea asp-for="ShortDescription"
                      rows="2"
                      class="w3-input w3-border">
            </textarea>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="Story"></label>
            <textarea asp-for="Story"
                      rows="2"
                      class="w3-input w3-border">
            </textarea>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="Features"></label>
            <textarea asp-for="Features"
                      rows="2"
                      class="w3-input w3-border">
            </textarea>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="Status"></label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<CatShelter.Models.Animal.Status>()"
                    class="w3-select w3-border">
            </select>
        </div>
        <div class="w3-margin-bottom">
            <label asp-for="SortOrder">Display priority</label>
            <input asp-for="SortOrder"
                   type="number"
                   min="1"
                   class="w3-input w3-border" />

            <small>
                Leave empty for normal ordering.
            </small>
        </div>

        <button type="submit"
                class="w3-button w3-green">
            Save
        </button>
        <a asp-action="Index"
           class="w3-button w3-light-grey">
            Back
        </a>
    </form>

    <hr/>

    <h3>Photos</h3>

    <form asp-action="AddPhotos"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" name="AnimalId" value="@Model.Id" />

        <div class="w3-margin-bottom">
            <label>Select photos</label>
            <input type="file"
                   name="Files"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp"
                   class="w3-input w3-border" />
            <span class="w3-text-red">@Html.ValidationMessage("Files")</span>
            <small>Up to 10 photos. Maximum 10 MB per photo.</small>
        </div>

        <button type="submit"
                class="w3-button w3-green">
            Upload Photos
        </button>

    </form>
    
</div>
<div>
    @if (Model.Photos.Count == 0)
    {
        <p class="w3-center">No photos uploaded yet</p>
    }
    else
    {
        <div class="w3-row-padding w3-margin-top">
            @foreach (var photo in Model.Photos)
            {
                <div class="w3-col l4 m6 s12 w3-margin-bottom">
                    <div class="w3-card">
                        <img src="@photo.Url" style="max-width:100%; height:auto" />
                        <div class="w3-container">
                            @if (photo.IsMain)
                            {
                                <div class="w3-row">
                                    <p class="w3-left">Main photo</p>
                                    <p class="w3-right">
                                        Priority:
                                        @(photo.SortOrder?.ToString() ?? "-")
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="w3-row">                                    
                                    <p class="w3-right">
                                        Priority:
                                        @(photo.SortOrder?.ToString() ?? "-")
                                    </p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(photo.Comment))
                            {
                                <p>@photo.Comment</p>
                            }

                            <div class="w3-margin-bottom w3-center">
                                @if (!photo.IsMain)
                                {
                                    <form asp-action="SetMainPhoto"
                                          method="post"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="photoId"
                                               value="@photo.Id" />

                                        <button type="submit"
                                                class="w3-button w3-blue">
                                            Set Main
                                        </button>
                                    </form>
                                }
                                <button type="button"
                                        class="w3-button w3-blue"
                                        onclick="document.getElementById('edit-photo-@photo.Id').style.display='block'">
                                    Edit
                                </button>
                                <form asp-action="DeletePhoto"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this photo?');">

                                    <input type="hidden"
                                           name="photoId"
                                           value="@photo.Id" />

                                    <button type="submit"
                                            class="w3-button w3-red">
                                        Delete
                                    </button>
                                </form>
                            </div>
                            
                        </div>
                    </div>
                </div>
                
                // Modal
                <div id="edit-photo-@photo.Id"
                     class="w3-modal">

                    <div class="w3-modal-content"
                         style="max-width:600px; padding:32px 16px;">

                        <div class="w3-container">

                            <span onclick="document.getElementById('edit-photo-@photo.Id').style.display='none'"
                                  class="w3-button w3-display-topright">
                                &times;
                            </span>

                            <h3>Edit Photo</h3>

                            <form asp-action="EditPhoto"
                                  method="post">

                                <input type="hidden"
                                       name="Id"
                                       value="@photo.Id" />

                                <input type="hidden"
                                       name="AnimalId"
                                       value="@Model.Id" />

                                <div class="w3-margin-bottom">
                                    <label>Comment</label>

                                    <textarea name="Comment"
                                      rows="3"
                                      class="w3-input w3-border">@photo.Comment</textarea>
                                </div>

                                <div class="w3-margin-bottom">
                                    <label>Priority</label>

                                    <input type="number"
                                           name="SortOrder"
                                           min="1"
                                           value="@photo.SortOrder"
                                           class="w3-input w3-border" />
                                </div>

                                <button type="submit"
                                        class="w3-button w3-green">
                                    Save
                                </button>

                                <button type="button"
                                        class="w3-button w3-light-grey"
                                        onclick="document.getElementById('edit-photo-@photo.Id').style.display='none'">
                                    Cancel
                                </button>

                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
