@model CatShelter.Models.Blog.BlogPost

@{
    ViewData["Title"] = "Delete Blog Post";
}

<div class="w3-container"
     style="max-width:700px; margin:auto; padding:64px 16px;">
    <h2>Delete Blog Post</h2>

    <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>

    <form asp-action="DeleteConfirmed"         
        method="post">
        
        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="w3-button w3-red">
            Delete
        </button>

        <a asp-action="Index"
           class="w3-button w3-light-grey">
            Cancel
        </a>
    </form>
</div>