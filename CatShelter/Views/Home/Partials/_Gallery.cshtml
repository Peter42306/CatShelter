@model List<CatShelter.ViewModels.Gallery.GalleryPhotoViewModel>

<section class="w3-container" id="gallery">
    <div class="content-section-narrow">
        <h3 class="w3-center">НАШИ ФОТО</h3>
        <p class="w3-large">Загляните в нашу фотогалерею, чтобы увидеть больше фотографий наших питомцев, их повседневную жизнь, истории спасения и счастливые моменты в ожидании нового дома.</p>        
    </div>

    <div class="w3-row" style="margin-top: 32px">

        @if (Model.Count > 0)
        {
            @foreach (var photo in Model)
            {
                <div class="w3-col l3 m4 s6" style="padding: 8px;">
                    <img src="@photo.Url"
                         class="w3-hover-opacity gallery-photo"
                         onclick="onClick(this)"                         
                         alt="@(photo.Comment ?? "Our cats")">
                </div>
            }
        }


        @* <div class="w3-col l3 m4 s6" style="padding: 8px;">
            <img src="https://hel1.your-objectstorage.com/images-media/lu-koshka/lu-koshka-horizontal-example-20260411_100037_1.jpg" style="width:100%;" onclick="onClick(this)" class="w3-hover-opacity" alt="Cat">            
        </div>
        <div class="w3-col l3 m4 s6" style="padding: 8px;">
            <img src="https://hel1.your-objectstorage.com/images-media/lu-koshka/lu-koshka-horizontal-example-20260411_100037_1.jpg" style="width:100%;" onclick="onClick(this)" class="w3-hover-opacity" alt="Cat">
        </div>
        <div class="w3-col l3 m4 s6" style="padding: 8px;">
            <img src="https://hel1.your-objectstorage.com/images-media/lu-koshka/lu-koshka-horizontal-example-20260411_100037_1.jpg" style="width:100%;" onclick="onClick(this)" class="w3-hover-opacity" alt="Cat">
        </div>
        <div class="w3-col l3 m4 s6" style="padding: 8px;">
            <img src="https://hel1.your-objectstorage.com/images-media/lu-koshka/lu-koshka-horizontal-example-20260411_100037_1.jpg" style="width:100%;" onclick="onClick(this)" class="w3-hover-opacity" alt="Cat">
        </div> *@
    </div>
    <div class="content-section-narrow">
        <div class="w3-col">
            <a href="all-cats-page.html" class="w3-button w3-light-grey">
                Смотреть все фото
            </a>
        </div>
    </div>

    <div id="modal01"
         class="w3-modal w3-black"
         style="padding-top:0;"
         onclick="this.style.display='none'">

        <div style="display:flex;
                align-items:center;
                justify-content:center;
                min-height:100vh;">

            <img id="img01"
                 class="w3-image w3-animate-zoom"
                 style="max-height:90vh;
                    max-width:90vw;
                    width:auto;
                    height:auto;">
        </div>
    </div>

</section>